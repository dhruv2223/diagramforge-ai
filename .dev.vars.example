# Copy this file to .dev.vars and fill in your keys
# cp .dev.vars.example .dev.vars

OPENAI_API_KEY=your-openai-api-key-here

# Free signup at https://www.braintrust.dev — used for the eval dashboard (npm run eval)
BRAINTRUST_API_KEY=your-braintrust-api-key-here

# Free signup at https://tavily.com — 1000 searches/month free tier
# Used by the searchWeb tool
TAVILY_API_KEY=your-tavily-api-key-here

# Free signup at https://upstash.com — create a Vector index with a hosted
# embedding model selected. Used by the searchKnowledge tool and `npm run embed`
UPSTASH_VECTOR_REST_URL=https://your-index.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your-upstash-vector-token-here
